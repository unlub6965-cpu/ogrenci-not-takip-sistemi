import json

class Ogrenci:
    def __init__(self, no, ad, vize, final):
        self.no = str(no)
        self.ad = ad
        self.vize = float(vize)
        self.final = float(final)
        self.ortalama = self.vize * 0.4 + self.final * 0.6
        self.durum = "Geçti" if self.ortalama >= 50 else "Kaldı"

    def to_dict(self):
        return {
            "no": self.no,
            "ad": self.ad,
            "vize": self.vize,
            "final": self.final,
            "ortalama": round(self.ortalama, 2),
            "durum": self.durum
        }

class NotSistemi:
    def __init__(self, dosya_adi="ogrenciler.json"):
        self.dosya_adi = dosya_adi
        self.ogrenciler = []
        self.dosyadan_yukle()

    def dosyadan_yukle(self):
        try:
            with open(self.dosya_adi, "r", encoding="utf-8") as f:
                self.ogrenciler = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.ogrenciler = []

    def dosyaya_kaydet(self):
        try:
            with open(self.dosya_adi, "w", encoding="utf-8") as f:
                json.dump(self.ogrenciler, f, ensure_ascii=False, indent=4)
        except IOError as e:
            print(f"Dosya kaydetme hatası: {e}")

    def ogrenci_ekle(self):
        no = input("Öğrenci Numarası: ").strip()
        ad = input("Öğrenci Adı Soyadı: ").strip()
        if not no or not ad:
            print("Hata: Numara veya ad boş bırakılamaz!")
            return

        try:
            vize = float(input("Vize Notu (0-100): "))
            final = float(input("Final Notu (0-100): "))
            if not (0 <= vize <= 100 and 0 <= final <= 100):
                print("Hata: Notlar 0 ile 100 arasında olmalıdır!")
                return
        except ValueError:
            print("Hata: Not alanlarına sadece sayısal değer girmelisiniz!")
            return

        yeni_ogr = Ogrenci(no, ad, vize, final)
        self.ogrenciler.append(yeni_ogr.to_dict())
        self.dosyaya_kaydet()
        print(f"-> {ad} başarıyla sisteme eklendi.")

    def ogrencileri_listele(self):
        if not self.ogrenciler:
            print("Sistemde henüz kayıtlı öğrenci yok.")
            return
        print("\n--- ÖĞRENCİ LİSTESİ ---")
        for o in self.ogrenciler:
            print(f"No: {o['no']} | Ad: {o['ad']} | Ort: {o['ortalama']} | Durum: {o['durum']}")

    def ogrenci_ara(self):
        kriter = input("Aramak istediğiniz öğrenci adı veya numarası: ").strip().lower()
        bulunanlar = [o for o in self.ogrenciler if kriter in o['ad'].lower() or kriter in o['no']]
        if bulunanlar:
            print(f"\nBulunan Kayıtlar ({len(bulunanlar)} adet):")
            for o in bulunanlar:
                print(f"No: {o['no']} | Ad: {o['ad']} | Vize: {o['vize']} | Final: {o['final']} | Ort: {o['ortalama']}")
        else:
            print("Eşleşen öğrenci bulunamadı.")

    def ogrenci_sil(self):
        no = input("Silinecek Öğrenci Numarası: ").strip()
        onceki_sayi = len(self.ogrenciler)
        self.ogrenciler = [o for o in self.ogrenciler if o['no'] != no]
        if len(self.ogrenciler) < onceki_sayi:
            self.dosyaya_kaydet()
            print(f"{no} numaralı öğrenci silindi.")
        else:
            print("Bu numaraya ait öğrenci bulunamadı.")

    def rapor_goruntule(self):
        if not self.ogrenciler:
            print("Rapor oluşturmak için yeterli veri yok.")
            return
        toplam = len(self.ogrenciler)
        gecenler = sum(1 for o in self.ogrenciler if o['durum'] == "Geçti")
        kalanlar = toplam - gecenler
        sinif_ortalamasi = sum(o['ortalama'] for o in self.ogrenciler) / toplam

        print("\n===== GENEL BAŞARI RAPORU =====")
        print(f"Toplam Öğrenci Sayısı : {toplam}")
        print(f"Geçen Sayısı          : {gecenler}")
        print(f"Kalan Sayısı          : {kalanlar}")
        print(f"Sınıf Not Ortalaması  : {sinif_ortalamasi:.2f}")
        print("================================")

def main():
    sistem = NotSistemi()
    while True:
        print("\n--- ÖĞRENCİ NOT TAKİP SİSTEMİ ---")
        print("1. Öğrenci Ekle")
        print("2. Öğrencileri Listele")
        print("3. Öğrenci Ara")
        print("4. Öğrenci Sil")
        print("5. Özet Başarı Raporu")
        print("6. Çıkış")
        secim = input("Seçiminiz (1-6): ").strip()

        if secim == "1":
            sistem.ogrenci_ekle()
        elif secim == "2":
            sistem.ogrencileri_listele()
        elif secim == "3":
            sistem.ogrenci_ara()
        elif secim == "4":
            sistem.ogrenci_sil()
        elif secim == "5":
            sistem.rapor_goruntule()
        elif secim == "6":
            print("Programdan çıkılıyor...")
            break
        else:
            print("Geçersiz seçim! Lütfen 1-6 arasında bir değer girin.")

if __name__ == "__main__":
    main()


       


